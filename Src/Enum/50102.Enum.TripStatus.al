enum 50102 "Trip Status"
{
    Extensible = true;
    value(0; " ")
    {
        Caption = ' ';
    }
    value(1; Open)
    {
        Caption = 'Open';
    }
    value(2; "Pending Approval")
    {
        Caption = 'Pending Approval';
    }
    value(3; Approved)
    {
        Caption = 'Approved';
    }
    value(4; Live)
    {
        Caption = 'Live';
    }
    value(5; "Completed")
    {
        Caption = 'Completed';
    }
    value(6; Terminated)
    {
        Caption = 'Terminated';
    }
    value(7; Invoiced)
    {
        Caption = 'Invoiced';
    }

}